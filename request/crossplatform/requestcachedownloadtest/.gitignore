# ===== Build outputs =====
entry/build/
.arkui-x/android/app/build/
.arkui-x/android/.gradle/
.arkui-x/ios/build/
.arkui-x/ios/Pods/

# ArkUI-X SDK libs pulled in on demand by ace build (network/crypto/etc)
# Core libs like libarkui_android.so are tracked; these are regenerated
# when the corresponding @ohos.* module is actually imported.
.arkui-x/android/app/libs/arm64-v8a/libcrypto_openssl.so
.arkui-x/android/app/libs/arm64-v8a/libfile_fs.so
.arkui-x/android/app/libs/arm64-v8a/libfile_streamrw.so
.arkui-x/android/app/libs/arm64-v8a/libnet_socket.so
.arkui-x/android/app/libs/arm64-v8a/libnet_utils.so
.arkui-x/android/app/libs/arm64-v8a/libssl_openssl.so
.arkui-x/android/app/libs/arm64-v8a/libutil.so
.arkui-x/android/app/libs/arm64-v8a/libutil_stream.so

# ArkUI-X compiled assets — regenerated by buildArkTS during `ace run`/`ace build`
# (from entry/build/ + $arkuiXSdkPath/engine/systemres). Keeping them bloats history.
.arkui-x/android/app/src/main/assets/arkui-x/entry/
.arkui-x/android/app/src/main/assets/arkui-x/entry_test/
.arkui-x/android/app/src/main/assets/arkui-x/systemres/
.arkui-x/ios/arkui-x/

# ===== Generated / cache =====
.hvigor/
.idea/
oh_modules/
**/build/
**/.cxx/

# ===== Machine-specific =====
local.properties
.arkui-x/android/local.properties
.arkui-x/ios/local.properties

# ===== OMC operational state (skills/ is the committable exception) =====
.omc/*
!.omc/skills/
.arkui-x/android/buildArkTS
.arkui-x/android/buildArkTS.bat

# ===== OS / editor =====
.DS_Store
Thumbs.db
*.swp
*.log
