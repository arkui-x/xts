# ===== Build outputs =====
entry/build/
.arkui-x/android/app/build/
.arkui-x/android/.gradle/
.arkui-x/ios/build/
.arkui-x/ios/Pods/

# Android libs and compiled assets are generated by hvigor (RuntimeLib/SdkApiLib/
# SdkComponentLib tasks) from the ArkUI-X SDK on every `build apps`; nothing under
# libs/ or assets/arkui-x/ is tracked (same convention as the requesttest suites).
.arkui-x/android/app/libs/*
.arkui-x/android/app/src/main/assets/arkui-x/
.arkui-x/ios/arkui-x/
.arkui-x/ios/frameworks/

# ===== Generated / cache =====
.hvigor/
.idea/
oh_modules/
**/build/
**/.cxx/

# ===== Machine-specific =====
local.properties
.arkui-x/android/local.properties
.arkui-x/ios/local.properties

# ===== OMC operational state (skills/ is the committable exception) =====
.omc/*
!.omc/skills/
.arkui-x/android/buildArkTS
.arkui-x/android/buildArkTS.bat

# ===== OS / editor =====
.DS_Store
Thumbs.db
*.swp
*.log
